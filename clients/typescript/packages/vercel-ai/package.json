{
  "name": "@agentegrity/vercel-ai",
  "version": "0.11.0",
  "description": "Zero-config agentegrity adapter for the Vercel AI SDK (ai). TypeScript-native addition with no Python equivalent.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "AGENTEGRITY_OFFLINE=1 node --test --import tsx src/*.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agentegrity",
    "vercel",
    "ai-sdk",
    "opentelemetry",
    "agent",
    "security"
  ],
  "dependencies": {
    "@agentegrity/client": "0.11.0"
  },
  "peerDependencies": {
    "ai": ">=3.4.10"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ai": "^6.0.0",
    "ai5": "npm:ai@^5.0.0",
    "ai7": "npm:ai@^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "zod": "^4"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/cogensec/agentegrity/tree/main/clients/typescript/packages/vercel-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogensec/agentegrity.git",
    "directory": "clients/typescript/packages/vercel-ai"
  },
  "bugs": {
    "url": "https://github.com/cogensec/agentegrity/issues"
  }
}
