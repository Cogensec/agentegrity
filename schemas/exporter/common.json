{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentegrity.cogensec.com/schemas/exporter/common.json",
  "title": "Agentegrity exporter common definitions",
  "description": "Shared $defs reused by session_start, event, and session_end schemas.",
  "$defs": {
    "AgentProfile": {
      "type": "object",
      "required": [
        "agent_id",
        "name",
        "agent_type",
        "capabilities",
        "deployment_context",
        "risk_tier"
      ],
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "agent_type": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deployment_context": {
          "type": "string"
        },
        "risk_tier": {
          "type": "string"
        },
        "framework": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "IntegrityScore": {
      "type": "object",
      "required": [
        "composite",
        "properties",
        "layer_results"
      ],
      "properties": {
        "composite": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "layer_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayerResult"
          }
        },
        "action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "LayerResult": {
      "type": "object",
      "required": [
        "layer_name",
        "score",
        "passed",
        "action"
      ],
      "properties": {
        "layer_name": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "passed": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "latency_ms": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "FrameworkEvent": {
      "type": "object",
      "required": [
        "event_type",
        "timestamp",
        "adapter_name",
        "data"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "pre_tool_use",
            "post_tool_use",
            "post_tool_use_failure",
            "user_prompt_submit",
            "stop",
            "subagent_start",
            "subagent_stop",
            "pre_compact"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "adapter_name": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "usage": {
              "$ref": "#/$defs/SessionUsage",
              "description": "On stop events: the session's usage so far."
            }
          },
          "additionalProperties": true
        },
        "evaluation_result": {
          "oneOf": [
            {
              "$ref": "#/$defs/IntegrityScore"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "SessionSummary": {
      "type": "object",
      "required": [
        "adapter",
        "agent_id",
        "evaluations",
        "events",
        "attestation_records",
        "chain_hash_linked",
        "enforce_mode"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "attestation_records": {
          "type": "integer",
          "minimum": 0
        },
        "chain_hash_linked": {
          "type": "boolean"
        },
        "enforce_mode": {
          "type": "boolean"
        },
        "exporters": {
          "type": "array",
          "description": "Network sinks this session streamed to. Empty means the run stayed local. Each entry carries a 'type' and, when the sink has a nameable destination, a 'target' origin. Never contains credentials.",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "credentials": {
          "type": "array",
          "description": "Credentials this session used, identified by keyed fingerprint rather than value, so a consumer can join an externally discovered leaked secret back to the agent that used it. Never contains the credential itself.",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "label",
              "fingerprint"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "A name, never a sample of the secret."
              },
              "fingerprint": {
                "type": "string",
                "description": "HMAC-SHA256 hex under the org key."
              }
            }
          }
        },
        "usage": {
          "$ref": "#/$defs/SessionUsage"
        }
      },
      "additionalProperties": true
    },
    "TokenUsage": {
      "type": "object",
      "description": "Token counts normalized across frameworks: cache and reasoning counts are parts of input and output, never added to them.",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Every input token processed, cached or not."
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Every generated token, reasoning included."
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "input_tokens + output_tokens."
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of input_tokens read from a prompt cache. Absent when no source reported it."
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of input_tokens written to a prompt cache. Absent when no source reported it."
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of output_tokens spent on reasoning. Absent when no source reported it."
        },
        "requests": {
          "type": "integer",
          "minimum": 0,
          "description": "Model calls counted. Absent when the source reports running totals without a call count."
        }
      },
      "additionalProperties": false
    },
    "SessionUsage": {
      "type": "object",
      "description": "Running token usage for a session: overall, per model, and how it was measured.",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "complete",
        "sources",
        "by_model"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Every input token processed, cached or not."
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Every generated token, reasoning included."
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "input_tokens + output_tokens."
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of input_tokens read from a prompt cache. Absent when no source reported it."
        },
        "cache_write_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of input_tokens written to a prompt cache. Absent when no source reported it."
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Part of output_tokens spent on reasoning. Absent when no source reported it."
        },
        "requests": {
          "type": "integer",
          "minimum": 0,
          "description": "Model calls counted. Absent when the source reports running totals without a call count."
        },
        "complete": {
          "type": "boolean",
          "description": "False when calls are known to be missing (a transcript that starts after compaction, a request without its final usage line, an estimate from running totals), so the totals are a lower bound."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "transcript",
              "provider_response",
              "trace"
            ]
          },
          "description": "Where the counts came from: a host transcript, the framework's model response, or a framework trace."
        },
        "by_model": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TokenUsage"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
