{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentegrity.cogensec.com/schemas/agent-event-v1.json",
  "title": "Agentegrity canonical agent event v1",
  "description": "Opt-in metadata-only interoperability contract. Source authentication claims are not independently verified by validating this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "agent_id",
    "run_id",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "$ref": "#/$defs/identifier"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "agent_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "integration",
        "assurance"
      ],
      "properties": {
        "host": {
          "$ref": "#/$defs/identifier"
        },
        "integration": {
          "$ref": "#/$defs/identifier"
        },
        "assurance": {
          "enum": [
            "unverified",
            "host_asserted",
            "authenticated"
          ]
        },
        "evidence_ref": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assurance": {
                "const": "authenticated"
              }
            },
            "required": [
              "assurance"
            ]
          },
          "then": {
            "required": [
              "evidence_ref"
            ]
          }
        }
      ]
    },
    "session_id": {
      "$ref": "#/$defs/identifier"
    },
    "action_id": {
      "$ref": "#/$defs/identifier"
    },
    "parent_event_id": {
      "$ref": "#/$defs/identifier"
    },
    "tool_name": {
      "$ref": "#/$defs/identifier"
    },
    "effect": {
      "$ref": "#/$defs/identifier"
    },
    "outcome": {
      "$ref": "#/$defs/identifier"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    }
  }
}
